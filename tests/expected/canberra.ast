(source googong [flow 8 6 4 3 2 1 1 0 0 0])
(source upper_molongolo [flow 4 5 7 6 4 3 2 1 0 0])
(source jerrabomberra [flow 2 3 5 4 3 2 1 1 0 0])
(river queanbeyan (delay googong 1))
(river central_molongolo (retain (+ (+ queanbeyan upper_molongolo) jerrabomberra) 0.9))
(river lower_molongolo (delay central_molongolo 1))
(outlet lower_molongolo)
