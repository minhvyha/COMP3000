(source joes (* [flow 12 8 5 3 2 1 0 0 0 0] 0.8))
(source mahers (* [flow 7 6 4 2 1 0 0 0 0 0] 0.65))
(source devlins (* [flow 4 7 6 4 2 1 0 0 0 0] 0.55))
